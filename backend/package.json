{
  "name": "@telc-prep/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts --local",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/*.test.ts",
    "db:seed": "tsx src/scripts/seed-plans.ts",
    "db:demo": "wrangler d1 execute telc-prep --local --file=src/db/seeds/demo.sql",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.11",
    "nanoid": "^5.0.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^3.88.0"
  }
}
