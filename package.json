{
  "name": "telc-prep",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend",
    "test": "npm run test -w backend && npm run test:a11y",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "db:seed": "npm run db:seed -w backend",
    "db:demo": "npm run db:demo -w backend",
    "admin:create": "npm run admin:create -w backend",
    "scrape:zertify:horen:teil1": "node scripts/inspect-zertify-horen.mjs teil1",
    "scrape:zertify:horen:teil2": "node scripts/inspect-zertify-horen.mjs teil2",
    "scrape:zertify:horen:teil3": "node scripts/inspect-zertify-horen.mjs teil3",
    "normalize:zertify:horen:teil1": "node scripts/normalize-zertify-horen.mjs 1",
    "normalize:zertify:horen:teil2": "node scripts/normalize-zertify-horen.mjs 2",
    "normalize:zertify:horen:teil3": "node scripts/normalize-zertify-horen.mjs 3",
    "puppeteer:install": "puppeteer browsers install chrome"
  },
  "devDependencies": {
    "puppeteer": "23.11.1"
  }
}
